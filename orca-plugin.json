{
  "manifestVersion": 2,
  "id": "talkback",
  "publisher": "callumjmac",
  "name": "Talkback",
  "version": "0.1.0",
  "description": "Hear your coding agents talk back. Forwards workspace focus and agent status to the local orca-talkback daemon, which speaks a short summary of each finished reply.",
  "license": "Apache-2.0",
  "repository": "https://github.com/CallumJMac/orca-talkback-plugin",
  "engines": {
    "orca": ">=1.4.248"
  },
  "execution": "trusted-worker",
  "pluginApi": 1,
  "main": "src/worker.ts",
  "capabilities": [
    {
      "kind": "workspace:read"
    },
    {
      "kind": "agent:read"
    }
  ],
  "contributes": {
    "events": [
      {
        "on": "workspace.changed"
      },
      {
        "on": "agent.status.changed"
      }
    ]
  }
}
